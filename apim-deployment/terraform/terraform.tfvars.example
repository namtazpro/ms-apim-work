# Copy this file to terraform.tfvars and edit values before `terraform apply`.

subscription_id     = "8bcaf808-26b1-45e4-8340-ec627a7afa0a"
resource_group_name = "rg-apimv2"
location            = "westeurope"
environment         = "dev"

# IMPORTANT: APIM names are globally unique. Pick something nobody else has used.
apim_name  = "apimv2may2026"
apim_sku   = "StandardV2_1" # tier_capacity --> 1 unit
# NOTE: azurerm 4.x only accepts `zones` on the Premium SKU.
# Leave empty for StandardV2 (to zone-pin StandardV2, switch the apim module to azapi).
apim_zones = []

publisher_name  = "Vincent Rouet"
publisher_email = "vincent.rouet@microsoft.com"

tags = {
  workload = "apim-demo"
  owner    = "virouet"
}

